services:

  nginx:
    image: nginx:alpine
    container_name: saasforge-nginx
    restart: unless-stopped

    ports:
      - "${APP_PORT:-8080}:80"

    volumes:
      - ./:/var/www/html
      - ./docker/nginx/conf.d:/etc/nginx/conf.d:ro

    depends_on:
      php:
        condition: service_started

    networks:
      - saasforge


  php:
    build:
      context: ./docker/php
      args:
        UID: ${UID:-1001}
        GID: ${GID:-1001}

    container_name: saasforge-php
    restart: unless-stopped

    working_dir: /var/www/html

    volumes:
      - ./:/var/www/html

    environment:
      APP_ENV: ${APP_ENV:-local}

    depends_on:
      mariadb:
        condition: service_healthy

      redis:
        condition: service_healthy

    networks:
      - saasforge


  queue:
    build:
      context: ./docker/php
      args:
        UID: ${UID:-1001}
        GID: ${GID:-1001}

    container_name: saasforge-queue
    restart: unless-stopped

    working_dir: /var/www/html

    command: php artisan queue:work --sleep=3 --tries=3 --timeout=90

    volumes:
      - ./:/var/www/html

    depends_on:
      php:
        condition: service_started

      mariadb:
        condition: service_healthy

      redis:
        condition: service_healthy

    networks:
      - saasforge


  scheduler:
    build:
      context: ./docker/php
      args:
        UID: ${UID:-1001}
        GID: ${GID:-1001}

    container_name: saasforge-scheduler
    restart: unless-stopped

    working_dir: /var/www/html

    command: >
      sh -c "while true; do
        php artisan schedule:run;
        sleep 60;
      done"

    volumes:
      - ./:/var/www/html

    depends_on:
      php:
        condition: service_started

    networks:
      - saasforge


  mariadb:
    image: mariadb:11.4

    container_name: saasforge-mariadb
    restart: unless-stopped

    ports:
      - "${DB_FORWARD_PORT:-3307}:3306"

    environment:
      MARIADB_DATABASE: ${DB_DATABASE:-saasforge}
      MARIADB_USER: ${DB_USERNAME:-saasforge}
      MARIADB_PASSWORD: ${DB_PASSWORD:-secret}
      MARIADB_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:-rootsecret}

    volumes:
      - mariadb_data:/var/lib/mysql

    healthcheck:
      test:
        [
          "CMD",
          "healthcheck.sh",
          "--connect",
          "--innodb_initialized"
        ]
      interval: 10s
      timeout: 5s
      retries: 10

    networks:
      - saasforge


  redis:
    image: redis:7-alpine

    container_name: saasforge-redis
    restart: unless-stopped

    ports:
      - "${REDIS_FORWARD_PORT:-6379}:6379"

    command: redis-server --appendonly yes

    volumes:
      - redis_data:/data

    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10

    networks:
      - saasforge


  node:
    image: node:22-alpine

    container_name: saasforge-node
    restart: unless-stopped

    working_dir: /var/www/html

    volumes:
      - ./:/var/www/html

    ports:
      - "${VITE_PORT:-5173}:5173"

    command: sh -c "npm install && npm run dev -- --host 0.0.0.0"

    networks:
      - saasforge


  phpmyadmin:
    image: phpmyadmin:latest

    container_name: saasforge-phpmyadmin
    restart: unless-stopped

    ports:
      - "${PHPMYADMIN_PORT:-8081}:80"

    environment:
      PMA_HOST: mariadb
      PMA_PORT: 3306
      PMA_ARBITRARY: 1

    depends_on:
      mariadb:
        condition: service_healthy

    networks:
      - saasforge


networks:

  saasforge:
    driver: bridge


volumes:

  mariadb_data:
    driver: local

  redis_data:
    driver: local
